+#define KSU_SUPPORT_ADD_TYPE
+
+//////////////////////////////////////////////////////
+// Declaration
+//////////////////////////////////////////////////////
+
+static struct avtab_node *get_avtab_node(struct policydb *db, struct avtab_key *key,
+                                         struct avtab_extended_perms *xperms);
